msgstr "a materiály o občanské vědě jako praxi"

#: eucitizensciencetheme/templates/about.html:114
msgid "Training modules"
msgstr "Školicí moduly"

#: eucitizensciencetheme/templates/about.html:115
msgid "on citizen science in a wide range of themes"
msgstr "o občanské vědě v široké škále témat"

#: eucitizensciencetheme/templates/about.html:118
msgid "that are involved in citizen science projects and research"
msgstr "kteří se podílejí na občanských vědeckých projektech a výzkumu"

#: eucitizensciencetheme/templates/about.html:120
msgid "Events calendar"
msgstr "Kalendář událostí"

